MAP_USAGE = "usage: %s map [SCOPE [PATH]]   |   %s map --rm [PATH]"


def map_target(arg):
    """PATH (relative to here, ~ allowed), or here itself, as an abspath."""
    p = os.path.abspath(os.path.join(here(), os.path.expanduser(arg or ".")))
    if re.search(r"[\s#]", p):
        die("scopes.map can't hold a path with whitespace or '#': %s" % p)
    if p in (os.sep, os.path.expanduser("~")):
        die("Refusing to link %s: every folder under it would wake that scope."
            % pretty(p))
    return p


def cmd_map(d, args):
    usage = MAP_USAGE % (ME, ME)
    rm = "--rm" in args
    args = [a for a in args if a != "--rm"]
    if any(a.startswith("-") for a in args) or len(args) > (1 if rm else 2):
        die(usage)
    p = os.path.join(d, "scopes.map")
    if not args and not rm:
        entries = scope_map(d)
        if not entries:
            print("No folder is linked to a scope yet. Link one: %s map SCOPE [PATH]" % ME)
            return
        at = here().rstrip(os.sep) + os.sep
        w = max(len(pretty(path)) for path, _ in entries)
        for path, s in entries:
            mark = at.startswith(path.rstrip(os.sep) + os.sep)
            print("%-*s  %s%s" % (w, pretty(path), s, "   <- here" if mark else ""))
        return
    scope = None if rm else check_scope(args[0])
    target = map_target(args[0] if rm and args else (args[1] if len(args) == 2 else None))
    with locked(d):
        scope_map(d)  # refuse to rewrite a file we can't parse
        lines = []
        if os.path.exists(p):
            with open(p, encoding="utf-8") as f:
                lines = f.read().splitlines()
        old, kept = None, []
        for line in lines:
            parts = line.split("#")[0].split()
            if parts and os.path.abspath(os.path.expanduser(parts[0])) == target:
                old = parts[1]
                if rm:
                    continue
                line = "%-19s %s" % (pretty(target), scope)
            kept.append(line)
        if rm and old is None:
            die("%s isn't linked to any scope. See: %s map" % (pretty(target), ME))
        if not rm and old is None:
            kept.append("%-19s %s" % (pretty(target), scope))
        if not rm and old == scope:
            print("%s is already linked to %s." % (pretty(target), scope))
            return
        tmp = p + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write("\n".join(kept) + "\n")
        os.replace(tmp, p)
    if rm:
        print("Unlinked %s (was %s)." % (pretty(target), old))
        return
    print("Linked %s -> %s%s. Wake there wakes %s; note there defaults to it."
          % (pretty(target), scope, "" if old is None else " (was %s)" % old, scope))
    if scope not in Model(d).scopes():
        print("(%s has no memories yet: it appears on its first note.)" % scope)


