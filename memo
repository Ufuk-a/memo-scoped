def confirm(question):
    print(question + " [y/N] ", end="", flush=True)
    return sys.stdin.readline().strip().lower() in ("y", "yes")


def cmd_move(d, args):
    src = dst = pattern = None
    yes, spec = False, None
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--to", "--from", "--match") and i + 1 < len(args):
            v = args[i + 1]
            if a == "--to":
                dst = check_scope(v)
            elif a == "--from":
                src = check_scope(v)
            else:
                try:
                    pattern = re.compile(v, re.I)
                except re.error as e:
                    die("bad regex: %s" % e)
            i += 2
        elif a == "--yes":
            yes, i = True, i + 1
        elif spec is None and not a.startswith("--"):
            spec, i = a, i + 1
        else:
            die("usage: %s move <ids|--match REGEX> [--from S] --to S [--yes]" % ME)
    if dst is None or (spec is None) == (pattern is None):
        die("usage: %s move <ids|--match REGEX> [--from S] --to S [--yes]" % ME)
    m = Model(d)
    if spec is not None:
        chosen = []
        for i in parse_ids(spec):
            if i not in m.leaves:
                die("No memory #%d." % i)
            chosen.append(m.leaves[i])
    else:
        chosen = [l for l in sorted(m.leaves.values(), key=lambda l: l["id"])
                  if not l["dropped"] and pattern.search(l["text"])]
    chosen = [l for l in chosen if (src is None or l["scope"] == src)
              and l["scope"] != dst]
    if not chosen:
        print("Nothing to move.")
        return
    for l in chosen:
        print("[%s] %s%s" % (l["scope"], "(dropped) " if l["dropped"] else "", leaf_line(l)))
    ids = [l["id"] for l in chosen]
    if not yes and not confirm("Move %s to scope %s?" % (plural(len(ids), "memory"), dst)):
        print("Not moved.")
        return
    journal(d, [{"t": "move", "ids": ids, "scope": dst}])
    print("Moved %s to scope %s." % (plural(len(ids), "memory"), dst))
    nap = next_nap(Model(d))
    if nap:
        print("\n" + nap)


