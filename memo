        print("Created %s." % pretty(d))
    else:
        print("Found %s: %s." % (pretty(d), plural(len(Model(d).leaves), "memory")))
    print("Sizes live in %s/config; cwd mapping in %s/scopes.map."
          % (pretty(d), pretty(d)))


def v1_records(path, rec):
    """The fixed-width records of a v1 file, decoded one by one: slicing
    decoded text would shift every boundary after a multi-byte character."""
    with open(path, "rb") as f:
        buf = f.read()
    if len(buf) % rec:
        die("%s is %d bytes, not a multiple of %d: a partial record from a "
            "crash. v1 repairs it on its next write (any `memo note`), or "
            "truncate it to %d bytes." % (pretty(path), len(buf), rec,
                                          len(buf) - len(buf) % rec))
    return [buf[i * rec:(i + 1) * rec].decode().rstrip() for i in range(len(buf) // rec)]


def cmd_import_v1(d, args):
    if len(args) != 2:
        die("usage: %s import-v1 <v1-memory-dir> <scope-table.tsv>" % ME)
    src, table = args
    m = Model(d)
    if m.leaves:
        die("%s already holds %s. import-v1 needs an empty memory, so that "
            "v1 ids survive." % (pretty(d), plural(len(m.leaves), "memory")))
    v1log = os.path.join(src, "LOG.txt")
    if not os.path.exists(v1log):
        die("No v1 log at %s." % pretty(v1log))
    scopes = {}
    with open(table, encoding="utf-8") as f:
        lines = f.readlines()
    for n, line in enumerate(lines, 1):
        line = line.rstrip("\n")
        if not line.strip() or line.startswith("# "):
            continue
        parts = line.split("\t")
        if len(parts) != 2 or not parts[0].strip().lstrip("#").isdigit():
            die("%s line %d: expected `id<TAB>scope`, got: %s" % (pretty(table), n, line))
        scopes[int(parts[0].strip().lstrip("#"))] = check_scope(parts[1].strip())
    recs = []
    for k, line in enumerate(v1_records(v1log, V1_LOG_REC)):
        head, _, rest = line.partition(" ")
        date, _, text = rest.partition(" ")
        if not head.startswith("#") or not head[1:].isdigit() or int(head[1:]) != k:
            die("%s record %d is not `#%d <date> <text>`: %s" % (pretty(v1log), k, k, line[:60]))
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", date):
            die("%s record %d: bad date %s" % (pretty(v1log), k, date))
        recs.append({"t": "note", "id": k, "ts": date + "T00:00:00",
                     "scope": scopes.get(k, "core"), "text": text.strip()})
    if not recs:
        die("%s holds no memories." % pretty(v1log))
    bad = [(r["id"], text_error(r["text"])) for r in recs if text_error(r["text"])]
    if bad:
        die("%s: %s would not pass `note`:\n%s" % (
            pretty(v1log), plural(len(bad), "record"),
            "\n".join("  #%d: %s" % b for b in bad[:20])))
    unknown = sorted(i for i in scopes if i >= len(recs))
    if unknown:
        die("%s names ids the v1 log does not have: %s"
            % (pretty(table), ", ".join(str(i) for i in unknown[:10])))
    # v1 block summaries: not valid here (the tree has other boundaries), but
    # a fine hint for whoever answers the naps.
    hints = []
    tree_dir = os.path.join(src, "TREE")
    if os.path.isdir(tree_dir):
        for name in os.listdir(tree_dir):
            if not name.isdigit():
                continue
            s = int(name)
            for k, text in enumerate(v1_records(os.path.join(tree_dir, name), V1_TREE_REC)):
                if text:
                    hints.append((k * s, (k + 1) * s - 1, text))
    hints.sort()
    with locked(d):
        if Model(d).leaves:
            die("Another session wrote meanwhile; import-v1 needs an empty memory.")
        append_json(log_path(d), recs)
        with open(os.path.join(d, "cache", "v1_hints.txt"), "w", encoding="utf-8") as f:
            for lo, hi, text in hints:
                f.write("#%d-%d\t%s\n" % (lo, hi, text))
    m = Model(d)
    print("Imported %s into %s; %s saved to cache/v1_hints.txt."
          % (plural(len(recs), "memory"), plural(len(m.trees), "scope"),
             plural(len(hints), "v1 summary")))
    print("pending naps: %d. Run: %s nap" % (len(m.pending()), ME))


# ---------------------------------------------------------------- main

COMMANDS = {"init": cmd_init, "wake": cmd_wake, "note": cmd_note, "nap": cmd_nap,
            "edit": cmd_edit, "move": cmd_move, "drop": cmd_drop,
            "recall": cmd_recall, "zoom": cmd_zoom, "scopes": cmd_scopes,
            "map": cmd_map,
            "forget": cmd_forget, "config": cmd_config,
            "import-v1": cmd_import_v1, "check": cmd_check}


def main():
    usage = __doc__.strip().format(memo=ME)
    if len(sys.argv) < 2:
        print(usage)
        sys.exit(0)
    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        print("No such command: %s\n" % cmd, file=sys.stderr)
        print(usage, file=sys.stderr)
        sys.exit(1)
    try:
        if cmd == "init":
            cmd_init(memory_dir(), sys.argv[2:])
            return
        d = store()
        if cmd != "config":  # config must run even if the file is broken
            config(d)
        COMMANDS[cmd](d, sys.argv[2:])
    except OSError as e:
        die("%s: %s." % (pretty(e.filename or memory_dir()), e.strerror or e))


if __name__ == "__main__":
    main()
