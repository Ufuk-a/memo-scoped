def cmd_recall(d, args):
    scope, everything, pats = None, False, []
    i = 0
    while i < len(args):
        if args[i] == "--scope" and i + 1 < len(args):
            scope, i = check_scope(args[i + 1]), i + 2
        elif args[i] == "--all":
            everything, i = True, i + 1
        else:
            pats.append(args[i])
            i += 1
    if len(pats) != 1:
        die("usage: %s recall <regex> [--scope S] [--all]" % ME)
    try:
        pat = re.compile(pats[0], re.I)
    except re.error as e:
        die("bad regex: %s" % e)
    m = Model(d)
    out = []
    for l in sorted(m.leaves.values(), key=lambda l: (l["ts"], l["id"])):
        if l["dropped"] and not everything:
            continue
        if scope and l["scope"] != scope:
            continue
        if pat.search(l["text"]):
            out.append("[%s] %s%s" % (l["scope"], "(dropped) " if l["dropped"]
                                      else "", leaf_line(l)))
    for s in m.scopes():
        if scope and s != scope:
            continue
        t = m.trees[s]
        for n in sorted(t.nodes.values(), key=lambda n: (n.level, n.seq)):
            text = m.summaries.get(n.hash)
            if text is not None and pat.search(text):
                out.append("[%s] #%s %s" % (s, n.hash[:HASH_SHOW], text))
    if not out:
        print("No match.")
        return
    # The newest matches that fit the wake budget: a vague regex matches
    # everything, and everything does not fit a harness's output.
    kept, total = [], 0
    for line in reversed(out):
        total += nbytes(line)
        if total > WAKE_CHARS:
            break
        kept.append(line)
    kept.reverse()
    print("\n".join(kept))
    if len(kept) < len(out):
        print("Newest %d of %s. Narrow the regex." % (len(kept), plural(len(out), "match")))
    else:
        print("%s." % plural(len(out), "match"))


