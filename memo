#!/usr/bin/env python3
"""memo-scoped: OptMem with scopes, a permanent append-only memory.

  {memo} init                        create this memory.
  {memo} wake [scope ...] [--part K/N]
                                     read your memory. Run first, every session.
                                     --part: only slice K of N (for hook caps).
  {memo} note "..." [--scope S]      record one memory: one short line.
  {memo} nap [<node> "..."]          do the pending compressions.
  {memo} nap --json [--all]          the next (or every) pending nap, as JSON.
  {memo} edit <id> "..."             rewrite one memory in place.
  {memo} move <ids|--match RE> --to S [--from S] [--yes]
                                     retag memories into another scope.
  {memo} drop <ids>                  hide memories (recall --all still sees them).
  {memo} recall <regex> [--scope S] [--all]
                                     search every memory and every summary.
  {memo} zoom <node|id>              open a tree node: its children.
  {memo} scopes                      every scope: leaves, pending naps, summary.
  {memo} map [SCOPE [PATH]]          folder->scope links (scopes.map): list them,
                                     or link PATH (default: here) to SCOPE, so
                                     wake there wakes it and note defaults to it.
  {memo} map --rm [PATH]             remove PATH's link (default: here).
  {memo} forget <node>               drop a bad summary; nap rebuilds it.
  {memo} config [NAME=N]             show this memory's sizes, or change one.
  {memo} import-v1 <v1-dir> <tsv>    one-time migration from OptMem v1.
  {memo} check                       replay the journal and report its health.

The memories live in ~/.optmem/memory2, or in $MEMORY_DIR if set.
"Here" is $MEMO_CWD if set (a proxy from another machine sets it), else cwd.
ids are integers (`#12`), tree nodes are hash prefixes (`#a1b2c3`).
"""

import datetime
import fcntl
import hashlib
import json
import os
import re
import sys

# The store is UTF-8 by construction, so the tool reads and prints UTF-8
# no matter what the machine's locale says.
for _s in (sys.stdout, sys.stderr):
    if hasattr(_s, "reconfigure"):
        _s.reconfigure(encoding="utf-8")


def pretty(p):
    """A path as the user would type it: keep symlinks, fold $HOME to ~."""
    p, home = os.path.abspath(p), os.path.expanduser("~")
    return "~" + p[len(home):] if p.startswith(home + os.sep) else p


ME = pretty(__file__)

# The sizes a memory may override in its own `config` file.
KNOBS = {
    "WAKE_CHARS": (19000, "the memory context: how many bytes wake prints"),
    "CORE_CHARS": (5000, "of those, how many are reserved for scope core"),
    "ENTRY_CHARS": (280, "the longest one memory or summary may be, in bytes"),
    "FANOUT": (4, "tree shape: mean number of children per node"),
    "DORMANT_LINES": (20, "how many non-woken scopes wake lists, one line each"),
    "ROOT_STALE": (6, "new memories in a scope before its summary is re-asked"),
}
WAKE_CHARS = KNOBS["WAKE_CHARS"][0]
CORE_CHARS = KNOBS["CORE_CHARS"][0]
ENTRY_CHARS = KNOBS["ENTRY_CHARS"][0]
FANOUT = KNOBS["FANOUT"][0]
DORMANT_LINES = KNOBS["DORMANT_LINES"][0]
ROOT_STALE = KNOBS["ROOT_STALE"][0]
WAKE_FLOOR = 400  # what a woken scope costs at least: header, marker, one line

SCOPE_RE = re.compile(r"[a-z0-9_-]+(/[a-z0-9_-]+)*")
HASH_SHOW = 6  # how many hex digits of a node hash the tool prints
V1_LOG_REC = 320  # v1 fixed-width record sizes, for import-v1
V1_TREE_REC = 288


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def plural(n, word):
    if n == 1:
        return "1 " + word
    if word == "leaf":
        word = "leave"
    elif word.endswith("y"):
        word = word[:-1] + "ie"
    elif word.endswith(("s", "h", "x")):
        word += "e"
    return "%d %ss" % (n, word)


def nbytes(line):
    """What one printed line costs: its UTF-8 bytes plus the newline."""
    return len(line.encode()) + 1


# ---------------------------------------------------------------- store

def memory_dir():
    return os.path.expanduser(os.environ.get("MEMORY_DIR") or "~/.optmem/memory2")


def store():
    """The store directory, which only `init` may create: a typo in
    MEMORY_DIR must be an error, not a second empty identity."""
    d = memory_dir()
    if not os.path.isdir(d):
        die("No memory at %s.\nTo create one, run: %s init\n"
            "To use an existing one, point MEMORY_DIR at it." % (d, ME))
    os.makedirs(os.path.join(d, "cache"), exist_ok=True)
    return d


def log_path(d):
    return os.path.join(d, "LOG.jsonl")


def summaries_path(d):
    return os.path.join(d, "cache", "summaries.jsonl")


def roots_path(d):
    return os.path.join(d, "cache", "roots.jsonl")


class locked:
    """`with locked(d):` -- the one lock every write takes."""

    def __init__(self, d):
        self.path = os.path.join(d, ".lock")

    def __enter__(self):
        self.f = open(self.path, "a")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        self.f.close()


def append_json(path, objs):
    """Append records to a jsonl file: one line each, fsync'd. Callers hold
    the lock. A crash may have left a partial last line: it is finished with
    a newline first, so it stays one (malformed, ignored) line instead of
    swallowing the record appended after it."""
    with open(path, "a+b") as f:
        f.seek(0, os.SEEK_END)
        if f.tell() > 0:
            f.seek(-1, os.SEEK_END)
            if f.read(1) != b"\n":
                f.write(b"\n")
        for o in objs:
            f.write((json.dumps(o, ensure_ascii=False) + "\n").encode())
        f.flush()
        os.fsync(f.fileno())


def read_jsonl(path):
    """Every line of a jsonl file, as (lineno, obj|None, raw). A last line
    with no newline is a crash remnant: dropped, and reported as truncated."""
    try:
        with open(path, "rb") as f:
            data = f.read()
    except FileNotFoundError:
        return [], False
    truncated = bool(data) and not data.endswith(b"\n")
    parts = data.split(b"\n")
    remnant = parts.pop() if truncated else None
    out = []
    for n, raw in enumerate(parts, 1):
        if not raw.strip():
            continue
        try:
            obj = json.loads(raw.decode())
            if not isinstance(obj, dict):
                obj = None
        except (UnicodeDecodeError, ValueError):
            obj = None
        out.append((n, obj, raw))
    return out, remnant


# ---------------------------------------------------------------- config

def size(k, v, where=""):
    if not v.isdigit() or int(v) < (0 if k == "DORMANT_LINES" else 1):
        die("%s%s must be a positive whole number, not '%s'." % (where, k, v))
    if k == "FANOUT" and int(v) < 2:
        die("%sFANOUT is at least 2." % where)
    return int(v)


def overrides(d, lenient=False):
    """The knobs this memory sets for itself. lenient: report a bad line
    and skip it instead of stopping, so `config` can always repair it."""
    out = {}
    p = os.path.join(d, "config")
    if not os.path.exists(p):
        return out
    complain = (lambda msg: print(msg, file=sys.stderr)) if lenient else die
    with open(p, encoding="utf-8") as f:
        lines = f.readlines()
    for n, line in enumerate(lines, 1):
        line = line.split("#")[0].strip()
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        k, v = k.strip().upper(), v.strip()
        where = "%s line %d: " % (pretty(p), n)
        if k not in KNOBS:
            complain("%s%s is not a size. Delete the line, or name one of: %s."
                     % (where, k, ", ".join(KNOBS)))
        elif lenient and (not v.isdigit() or int(v) < (0 if k == "DORMANT_LINES" else 1)):
            complain("%s%s must be a positive whole number, not '%s'." % (where, k, v))
        else:
            out[k] = size(k, v, where)
    return out


def config(d):
    for k, v in overrides(d).items():
        globals()[k] = v


def write_config(d, over):
    out = ["# memo sizes for this memory. A commented line means: follow the",
           "# tool's default. Edit with `%s config NAME=VALUE`." % ME, ""]
    for k, (default, what) in KNOBS.items():
        out.append("%-2s%-14s = %-6d # %s"
                   % ("" if k in over else "# ", k, over.get(k, default), what))
    with open(os.path.join(d, "config"), "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")


# ---------------------------------------------------------------- scopes

def valid_scope(s):
    return bool(SCOPE_RE.fullmatch(s))


def check_scope(s):
    if not valid_scope(s):
        die("'%s' is not a scope name: [a-z0-9_-]+ parts joined by '/'." % s)
    return s


def scope_map(d):
    """scopes.map: `path  scope` per line, `#` comments, `~` expanded."""
    out = []
    p = os.path.join(d, "scopes.map")
    if not os.path.exists(p):
        return out
    with open(p, encoding="utf-8") as f:
        lines = f.readlines()
    for n, line in enumerate(lines, 1):
        line = line.split("#")[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) != 2 or not valid_scope(parts[1]):
            die("%s line %d: expected `path  scope`, got: %s"
                % (pretty(p), n, line))
        out.append((os.path.abspath(os.path.expanduser(parts[0])), parts[1]))
    return out


def here():
    """The folder the caller is in: $MEMO_CWD when a proxy ran us on its
    behalf over ssh (whose own cwd is just $HOME), else our cwd."""
    return os.path.abspath(os.environ.get("MEMO_CWD") or os.getcwd())


def cwd_matches(d):
    """Every scopes.map entry whose path is a prefix of cwd, longest first."""
    cwd = here()
    hits = [(path, s) for path, s in scope_map(d)
            if cwd == path or cwd.startswith(path.rstrip(os.sep) + os.sep)]
    hits.sort(key=lambda ps: -len(ps[0]))
    return [s for _, s in hits]


def cwd_scope(d):
    """The scope `note` uses without --scope: the longest match, else core."""
    hits = cwd_matches(d)
    return hits[0] if hits else "core"


# ---------------------------------------------------------------- journal

def now_ts():
    return datetime.datetime.now().replace(microsecond=0).isoformat()


def text_error(text):
    """Why a text is not a valid memory, or None."""
    if not text:
        return "Empty. A memory is one line of text."
    if any(ord(c) < 32 or ord(c) == 127 for c in text):
        return ("Control characters (newlines, tabs) are not allowed. A memory "
                "is one line: merge them, or note them separately.")
    n = len(text.encode())
    if n > ENTRY_CHARS:
        return ("Too long: %d bytes, limit %d. Accented characters cost 2 bytes. "
                "Compress it further." % (n, ENTRY_CHARS))
    return None


def check_text(text):
    text = text.strip()
    err = text_error(text)
    if err:
        die(err)
    return text


def valid_ids(v):
    return isinstance(v, list) and all(isinstance(i, int) for i in v)


def replay(d):
    """The effective leaf set: every journal line, applied in order.
    Returns (leaves by id, malformed [(lineno, why)], truncated, max_id).

    max_id is the largest id mentioned by ANY line, malformed, duplicate or
    truncated included: a crash remnant is sealed into a valid line by the
    next append, so its id must never be handed out again."""
    leaves, bad, max_id = {}, [], -1
    lines, remnant = read_jsonl(log_path(d))
    truncated = remnant is not None
    for raw in [raw for _, _, raw in lines] + ([remnant] if truncated else []):
        for mm in re.finditer(rb'"id"\s*:\s*(\d+)', raw):
            max_id = max(max_id, int(mm.group(1)))
    for n, o, raw in lines:
        t = o.get("t") if o else None
        if t == "note":
            ok = (isinstance(o.get("id"), int) and isinstance(o.get("ts"), str)
                  and isinstance(o.get("text"), str)
                  and isinstance(o.get("scope"), str) and valid_scope(o["scope"])
                  and o["id"] not in leaves)
            if ok:
                leaves[o["id"]] = {"id": o["id"], "ts": o["ts"], "scope": o["scope"],
                                   "text": o["text"], "dropped": False}
        elif t == "edit":
            ok = isinstance(o.get("id"), int) and isinstance(o.get("text"), str)
            if ok and o["id"] in leaves:
                leaves[o["id"]]["text"] = o["text"]
        elif t == "move":
            ok = (valid_ids(o.get("ids")) and isinstance(o.get("scope"), str)
                  and valid_scope(o["scope"]))
            if ok:
                for i in o["ids"]:
                    if i in leaves:
                        leaves[i]["scope"] = o["scope"]
        elif t == "drop":
            ok = valid_ids(o.get("ids"))
            if ok:
                for i in o["ids"]:
                    if i in leaves:
                        leaves[i]["dropped"] = True
        else:
            ok = False
        if not ok:
            bad.append((n, raw[:60].decode("utf-8", "replace")))
    return leaves, bad, truncated, max_id


def read_summaries(d):
    """node hash -> text. Last line per node wins; a null text is a tombstone."""
    out, bad = {}, 0
    lines, _ = read_jsonl(summaries_path(d))
    for n, o, raw in lines:
        if not o or not isinstance(o.get("node"), str):
            bad += 1
            continue
        if o.get("text") is None:
            out.pop(o["node"], None)
        elif isinstance(o["text"], str):
            out[o["node"]] = o["text"]
        else:
            bad += 1
    return out, bad


# ---------------------------------------------------------------- tree

def read_roots(d):
    """scope -> {"root", "nleaves", "text"}: the scope summaries, last wins."""
    out = {}
    lines, _ = read_jsonl(roots_path(d))
    for _, o, _ in lines:
        if (o and isinstance(o.get("scope"), str) and isinstance(o.get("root"), str)
                and isinstance(o.get("nleaves"), int) and isinstance(o.get("text"), str)):
            out[o["scope"]] = o
    return out


def sha1(s):
    return hashlib.sha1(s.encode()).hexdigest()


def leaf_hash(leaf):
    return sha1("%d\t%s\t%s" % (leaf["id"], leaf["ts"], leaf["text"]))


def closes_chunk(h):
    return int(sha1(h)[:8], 16) % FANOUT == 0


class Node:
    __slots__ = ("hash", "children", "complete", "level", "seq")

    def __init__(self, h, children, complete, level, seq):
        self.hash, self.children = h, children
        self.complete, self.level, self.seq = complete, level, seq


class Tree:
    """The tree of one scope: a pure function of its live leaves.

    Level 0 = leaves sorted by (ts, id). On each level, item i closes a
    chunk iff its hash says so (closes_chunk) AND the chunk already holds
    another item, or it is the last item of the level: a singleton never
    closes, it joins the next chunk, so no node has one child. The one
    exception is a last item with nothing to join: it is carried up as
    itself. Every level shrinks, so this terminates. Chunks become the
    nodes of the next level; repeat until one item: the root.

    A node is complete iff it closed by the hash rule AND its last child is
    complete (a leaf, or a complete node): a chunk that merely contains the
    open tail is still open, since its contents keep changing. Only complete
    nodes get summaries; open ones always print their children."""

    def __init__(self, scope, leaves):
        self.scope = scope
        self.leaves = {}  # leaf hash -> leaf
        self.nodes = {}   # node hash -> Node
        order = sorted(leaves, key=lambda l: (l["ts"], l["id"]))
        level = []
        for leaf in order:
            h = leaf_hash(leaf)
            self.leaves[h] = leaf
            level.append(h)
        depth, seq = 1, 0
        while len(level) > 1:
            nxt, chunk = [], []
            for i, h in enumerate(level):
                chunk.append(h)
                if not (closes_chunk(h) and len(chunk) > 1) and i < len(level) - 1:
                    continue
                if len(chunk) == 1:  # the level's last item, alone: carried up
                    nxt.append(h)
                else:
                    nh = sha1("\n".join(chunk))
                    complete = closes_chunk(h) and (h in self.leaves or self.nodes[h].complete)
                    self.nodes[nh] = Node(nh, chunk, complete, depth, seq)
                    seq += 1
                    nxt.append(nh)
                chunk = []
            level, depth = nxt, depth + 1
        self.root = level[0] if level else None

    def is_leaf(self, h):
        return h in self.leaves

    def leaf_set(self, h):
        """Every leaf id under an item (the item itself, if a leaf)."""
        if h in self.leaves:
            return {self.leaves[h]["id"]}
        out = set()
        for c in self.nodes[h].children:
            out |= self.leaf_set(c)
        return out


# ---------------------------------------------------------------- model

class Model:
    """Everything one invocation knows: the replayed journal, the summary
    cache, and one Tree per scope. Built once per command."""

    def __init__(self, d):
        self.d = d
        self.leaves, self.malformed, self.truncated, max_id = replay(d)
        self.summaries, self.bad_summaries = read_summaries(d)
        self.roots = read_roots(d)
        self.next_id = max(max_id, max(self.leaves, default=-1)) + 1
        by_scope = {}
        for leaf in self.leaves.values():
            if not leaf["dropped"]:
                by_scope.setdefault(leaf["scope"], []).append(leaf)
        self.trees = {s: Tree(s, ls) for s, ls in by_scope.items()}
        self.where = {}  # any hash (leaf or node) -> scope
        for s, t in self.trees.items():
            for h in t.leaves:
                self.where[h] = s
            for h in t.nodes:
                self.where[h] = s

    def scopes(self):
        return sorted(self.trees)

    def count(self, scope):
        return len(self.trees[scope].leaves) if scope in self.trees else 0

    def root_stale(self, scope):
        """Does the scope want a (new) scope summary? Yes if it has none, or
        ROOT_STALE memories arrived since the last one."""
        r = self.roots.get(scope)
        return r is None or self.count(scope) - r["nleaves"] >= ROOT_STALE

    def pending(self, scope=None, roots=False):
        """Complete nodes with every child settled (a leaf, or summarised)
        that have no summary themselves: bottom-up, oldest first. With
        roots=True (explicit `nap` only, never after a write: the root hash
        changes with every note), then the open roots of scopes whose scope
        summary is missing or ROOT_STALE memories old."""
        out, want = [], []
        for s in self.scopes() if scope is None else [scope]:
            t = self.trees.get(s)
            if not t:
                continue
            todo = []
            for n in t.nodes.values():
                if n.complete and n.hash not in self.summaries and all(
                        t.is_leaf(c) or c in self.summaries for c in n.children):
                    todo.append((n.level, n.seq, s, n.hash))
            out += todo
            if (roots and not todo and t.root in t.nodes
                    and not t.nodes[t.root].complete and self.root_stale(s)):
                want.append((s, t.root))
        out.sort()
        return [(s, h) for _, _, s, h in out] + want

    def resolve(self, prefix, pool=None):
        """A node hash from a prefix, as wake prints them (`#a1b2c3`)."""
        p = prefix.lstrip("#").lower()
        if not re.fullmatch(r"[0-9a-f]+", p):
            die("'%s' is not a node id. Copy it from wake, like #a1b2c3." % prefix)
        pool = self.where if pool is None else pool
        hits = [h for h in pool if h.startswith(p)]
        if not hits:
            die("No node #%s. Run: %s wake" % (p, ME))
        if len(hits) > 1:
            die("#%s is ambiguous (%d nodes). Use a longer prefix." % (p, len(hits)))
        return hits[0]

    def line(self, h):
        """One printed line for an item: a leaf, or a summarised node."""
        t = self.trees[self.where[h]]
        if t.is_leaf(h):
            return leaf_line(t.leaves[h])
        s = self.summaries.get(h)
        return "#%s %s" % (h[:HASH_SHOW], s if s is not None else "(no summary yet)")

    def root_summary(self, scope):
        """The scope in one line: its scope summary (with " (+N)" for the
        memories since), else its complete root's summary, else the newest
        summary among the root's children, else nothing."""
        t = self.trees.get(scope)
        if not t:
            return "(no summary yet)"
        r = self.roots.get(scope)
        if r:
            n = self.count(scope) - r["nleaves"]
            return r["text"] + (" (+%d)" % n if n > 0 else "")
        if t.root in self.summaries:
            return self.summaries[t.root]
        if t.root in t.nodes:
            for c in reversed(t.nodes[t.root].children):
                if c in self.summaries:
                    return "(newest era) " + self.summaries[c]
        return "(no summary yet)"


def leaf_line(leaf):
    return "#%d %s %s" % (leaf["id"], leaf["ts"][:10], leaf["text"])


def journal(d, objs):
    with locked(d):
        append_json(log_path(d), objs)


# ---------------------------------------------------------------- wake

def render_min(m, t, h):
    """The least an item can print as: a leaf line; a summary line for a
    summarised complete node; otherwise its children, recursively. Returns
    (entries, stale): entries are (hash, line, expandable), stale says an
    unsummarised complete node was forced open."""
    if t.is_leaf(h):
        return [(h, m.line(h), False)], False
    n = t.nodes[h]
    if (n.complete or h == t.root) and h in m.summaries:
        return [(h, m.line(h), True)], False
    out, stale = [], n.complete
    for c in n.children:
        e, s = render_min(m, t, c)
        out += e
        stale = stale or s
    return out, stale


def frontier(m, scope, budget):
    """The lines wake prints for one scope: header, then the tree opened
    from the root, most recent node first, while the budget allows.
    Returns (lines, bytes)."""
    t = m.trees.get(scope)
    header = "== %s (%s)" % (scope, plural(m.count(scope), "memory"))
    if not t:
        return [header], nbytes(header)
    entries, stale = render_min(m, t, t.root)
    cost = nbytes(header) + sum(nbytes(e[1]) for e in entries)
    while True:
        idx = next((i for i in range(len(entries) - 1, -1, -1)
                    if entries[i][2]), None)
        if idx is None:
            break
        rep, s = [], False
        for c in t.nodes[entries[idx][0]].children:
            e, cs = render_min(m, t, c)
            rep += e
            s = s or cs
        new = cost - nbytes(entries[idx][1]) + sum(nbytes(e[1]) for e in rep)
        if s and not stale:
            new += nbytes(" (stale)") - 1  # the header grows too
        if new > budget:
            break
        entries[idx:idx + 1] = rep
        cost, stale = new, stale or s
    if stale:
        header += " (stale)"
        cost += nbytes(" (stale)") - 1
    lines = [e[1] for e in entries]
    if cost > budget:
        # The floor (open tail, stale nodes) does not fit: drop the oldest
        # lines for one marker, keeping at least the newest. Never over budget.
        gone, marker, pend = 0, "", len(m.pending(scope))
        while len(lines) > 1 and cost + nbytes(marker) > budget:
            e = entries.pop(0)
            lines.pop(0)
            gone += len(t.leaf_set(e[0]))
            cost -= nbytes(e[1])
            marker = ("\u2026 %s omitted (pending naps: %d) \u2014 run %s nap"
                      % (plural(gone, "older memory"), pend, ME))
        lines.insert(0, marker)
        cost += nbytes(marker)
    return [header] + lines, cost


def wake_lines(m, woken):
    """The whole wake document. Budget: WAKE_CHARS in all; the dormant list
    and the last line are reserved first, core gets CORE_CHARS, the rest is
    split evenly among the other woken scopes, and what a scope leaves
    unused flows to the next."""
    pend = len(m.pending())
    last = "pending naps: %d | bytes: %%d | You are awake." % pend

    def dormant_tail(woken):
        dormant = ([s for s in woken_all if s not in woken] +
                   [s for s in m.scopes() if s not in woken_all])[:DORMANT_LINES]
        tail = ["-- other scopes:"] if dormant else []
        for s in dormant:
            tail.append("%s (%d): %s" % (s, m.count(s), m.root_summary(s)))
        return tail, WAKE_CHARS - sum(nbytes(l) for l in tail) - nbytes(last % 10 ** 9)

    # Too many woken scopes cannot fit: each costs at least WAKE_FLOOR. Keep
    # the first that do (core, cwd-mapped, args, in order), list the rest.
    woken_all = list(woken)
    tail, room = dormant_tail(woken)
    fits = 1 + max(0, (room - min(CORE_CHARS, room)) // WAKE_FLOOR)
    if fits < len(woken):
        woken = woken[:fits]
        tail, room = dormant_tail(woken)
    others = [s for s in woken if s != "core"]
    core = CORE_CHARS if others else room  # alone, core takes the whole room
    share = (room - CORE_CHARS) // len(others) if others else 0
    out, carry = [], 0
    for s in woken:
        budget = (core if s == "core" else share) + carry
        lines, cost = frontier(m, s, budget)
        out += lines
        carry = budget - cost
    out += tail
    total = sum(nbytes(l) for l in out)
    b = total
    for _ in range(3):  # the byte count includes its own line
        b = total + nbytes(last % b)
    out.append(last % b)
    return out


# Claude Code (>= 2.1.251) shows a hook's output inline only up to ~10,000
# chars; past that it saves it to a file and shows a 2 KB preview. `wake
# --part K/N` prints the K-th of N near-equal line-aligned slices, so N hook
# entries each stay under the cap. A slice over PART_WARN bytes says so.
PART_WARN = 9500


def wake_part(lines, k, n):
    """Slice k (1-based) of n: cut where the running byte count crosses
    i*total/n, never inside a line. Every line lands in exactly one slice."""
    sizes = [nbytes(l) for l in lines]
    total, run, out = sum(sizes), 0, [[] for _ in range(n)]
    for l, b in zip(lines, sizes):
        i = min(n - 1, run * n // total) if total else 0
        out[i].append(l)
        run += b
    part = out[k - 1]
    if sum(nbytes(l) for l in part) > PART_WARN:
        part = part + ["(memo: wake part %d/%d is over %d bytes; Claude Code "
                       "may truncate it. Add a hook entry and raise N.)"
                       % (k, n, PART_WARN)]
    return part


def cmd_wake(d, args):
    part = None
    if "--part" in args:
        i = args.index("--part")
        mt = re.fullmatch(r"(\d+)/(\d+)", args[i + 1] if i + 1 < len(args) else "")
        if not mt or not 1 <= int(mt.group(1)) <= int(mt.group(2)):
            die("--part wants K/N with 1 <= K <= N, e.g. --part 1/3")
        part = (int(mt.group(1)), int(mt.group(2)))
        args = args[:i] + args[i + 2:]
    m = Model(d)
    woken = ["core"]
    for s in cwd_matches(d) + [check_scope(a) for a in args]:
        if s not in woken:
            woken.append(s)
    lines = wake_lines(m, woken)
    if part:
        lines = wake_part(lines, *part)
    if lines:
        print("\n".join(lines))


# ---------------------------------------------------------------- naps

def nap_prompt(m, scope, h, left):
    t = m.trees[scope]
    n = t.nodes[h]
    lines = []

    def show(c, depth):
        if t.is_leaf(c) or c in m.summaries:
            lines.append("  " * depth + m.line(c))
        else:  # an open node (root naps only): open it, all the way down
            lines.append("  " * depth + "#%s (open):" % c[:HASH_SHOW])
            for g in t.nodes[c].children:
                show(g, depth + 1)
    for c in n.children:
        show(c, 1)
    what = "the whole scope %s (root #%s)" % (scope, h[:HASH_SHOW]) if \
        h == t.root else "node #%s (scope %s)" % (h[:HASH_SHOW], scope)
    tail = "" if not left else "\n%s after this one." % plural(left, "nap")
    return ("Compress %s, %s, into one line of at most %d bytes.\n"
            "Keep what has lasting effect, drop what does not. Invent "
            "nothing.\n\n%s\n%s\nRun: %s nap %s \"<your line>\""
            % (what, plural(len(n.children), "item"), ENTRY_CHARS,
               "\n".join(lines), tail, ME, h[:HASH_SHOW]))


def v1_hints(m):
    """cache/v1_hints.txt as [(from_date, to_date, line)], dated by the v1
    ids (= v2 ids after import-v1) the block covered. Empty if absent."""
    out = []
    p = os.path.join(m.d, "cache", "v1_hints.txt")
    if not os.path.exists(p):
        return out
    with open(p, encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            mm = re.match(r"#(\d+)-(\d+)\t", line)
            if not mm:
                continue
            days = [m.leaves[i]["ts"][:10] for i in range(int(mm.group(1)), int(mm.group(2)) + 1)
                    if i in m.leaves]
            if days:
                out.append((min(days), max(days), line.replace("\t", " ", 1)))
    return out


def nap_json(m, scope, h, left, hints):
    """One pending nap as a JSON-able dict, for a batch driver. Open
    children (root naps) are flattened into their leaves and summaries."""
    t = m.trees[scope]
    n = t.nodes[h]
    children = []

    def flat(c):
        if t.is_leaf(c):
            l = t.leaves[c]
            children.append({"kind": "leaf", "id": l["id"], "ts": l["ts"], "text": l["text"]})
        elif c in m.summaries:
            children.append({"kind": "summary", "node": c, "text": m.summaries[c]})
        else:
            for g in t.nodes[c].children:
                flat(g)
    for c in n.children:
        flat(c)
    ids = t.leaf_set(h)
    ts = sorted(m.leaves[i]["ts"] for i in ids)
    lo, hi = ts[0][:10], ts[-1][:10]
    return {"node": h, "scope": scope, "level": n.level,
            "span": {"from_ts": ts[0], "to_ts": ts[-1], "leaves": len(ids)},
            "children": children,
            "hints": [line for a, b, line in hints if a <= hi and b >= lo],
            "remaining": left}


def next_nap(m, roots=False):
    todo = m.pending(roots=roots)
    if not todo:
        return None
    s, h = todo[0]
    return nap_prompt(m, s, h, len(todo) - 1)


def cmd_nap(d, args):
    m = Model(d)
    said = False
    if args and args[0] == "--json":
        if args[1:] not in ([], ["--all"]):
            die("usage: %s nap --json [--all]" % ME)
        todo = m.pending(roots=True)
        hints = v1_hints(m) if todo else []
        naps = [nap_json(m, s, h, len(todo) - i - 1, hints) for i, (s, h) in enumerate(todo)]
        out = naps if args[1:] else (naps[0] if naps else None)
        print(json.dumps(out, ensure_ascii=False, indent=1))
        return
    if args:
        if len(args) != 2:
            die("usage: %s nap <node> \"<one line>\"" % ME)
        h = m.resolve(args[0])
        t = m.trees[m.where[h]]
        if t.is_leaf(h):
            die("#%s is a memory, not a node. Only nodes get summaries." % args[0])
        if not t.nodes[h].complete and h != t.root:
            die("#%s is the open tail of its scope: it is shown raw, never "
                "summarised. Run: %s nap" % (args[0], ME))
        text = check_text(args[1])
        scope = m.where[h]
        if h == t.root and not t.nodes[h].complete:
            rec = {"scope": scope, "root": h, "nleaves": m.count(scope), "text": text}
            with locked(d):
                append_json(roots_path(d), [rec])
            m.roots[scope] = rec
            print("Scope %s summarised (#%s)." % (scope, h[:HASH_SHOW]))
        else:
            with locked(d):
                append_json(summaries_path(d), [{"node": h, "text": text}])
            m.summaries[h] = text
            print("#%s saved." % h[:HASH_SHOW])
        said = True
    nap = next_nap(m, roots=True)
    if not nap:
        print("Nothing left to compress.")
        return
    print(("\n" if said else "") + nap)


